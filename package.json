{
  "name": "quietneeds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build && node scripts/check-production.mjs",
    "preview": "rsbuild preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "node --test tests/firestore.rules.mjs"
  },
  "dependencies": {
    "firebase": "^12.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@rsbuild/core": "1.7.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  }
}
