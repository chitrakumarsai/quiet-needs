# Firebase WEB configuration, not a Gemini secret or service-account key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Development only. Generated App Check token must stay private.
VITE_APPCHECK_DEBUG=false
# Optional registered token for local development; leave blank to generate one.
# Never publish a development build containing this value.
VITE_APPCHECK_DEBUG_TOKEN=

# P2 sharing remains disabled unless Auth and Firestore rules are configured.
VITE_SHARING_ENABLED=false
# Development only. Routes account and Firestore operations to local demo emulators.
VITE_SHARING_EMULATORS=false

# Enable organizer cloud proposals only on a configured Firebase project.
VITE_PLANNER_CLOUD_ENABLED=false
VITE_PLANNER_MODEL=gemini-3.5-flash-lite
